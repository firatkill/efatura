{
  "name": "@firatkill/efatura",
  "version": "0.0.0",
  "description": "Parse Turkish e-invoices (UBL-TR e-Fatura and e-Arşiv) into typed data. Works in Node and the browser.",
  "keywords": [
    "e-fatura",
    "efatura",
    "e-arsiv",
    "ubl-tr",
    "ubl",
    "gib",
    "invoice",
    "fatura",
    "turkey",
    "turkiye",
    "kdv",
    "tevkifat",
    "xml",
    "parser"
  ],
  "license": "MIT",
  "author": "Fırat Kıl",
  "homepage": "https://efatura.firatkil.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatkill/efatura.git"
  },
  "bugs": {
    "url": "https://github.com/firatkill/efatura/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zip": {
      "import": {
        "types": "./dist/zip.d.ts",
        "default": "./dist/zip.js"
      },
      "require": {
        "types": "./dist/zip.d.cts",
        "default": "./dist/zip.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "zip": [
        "./dist/zip.d.cts"
      ]
    }
  },
  "bin": {
    "efatura": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && pnpm --filter playground typecheck",
    "test": "vitest run --project unit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "size": "size-limit",
    "publint": "publint --strict",
    "attw": "attw --pack .",
    "test:package": "node --test test/package/*.test.mjs",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:cli": "pnpm build && vitest run --project cli",
    "licenses:check": "node scripts/check-licenses.mjs",
    "docs:check": "tsx scripts/check-docs.ts",
    "changeset": "changeset",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:cli && pnpm test:package && pnpm test:tooling && pnpm size && pnpm publint && pnpm attw && pnpm licenses:check && pnpm docs:check"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@size-limit/preset-small-lib": "11.2.0",
    "@types/node": "20.19.43",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "11.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
